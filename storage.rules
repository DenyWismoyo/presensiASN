rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAtasanOrAdmin() {
      return isAuthenticated() && (
        request.auth.token.role in ['admin', 'atasan'] ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*@surakarta\\.go\\.id'))
      );
    }

    // 1. Path Hierarki Standar ASN: /presensi-pegawai/{orgId}/{userId}/{allPaths=**}
    match /presensi-pegawai/{orgId}/{userId}/{allPaths=**} {
      // Pembacaan: Pemilik berkas, atau Atasan/Admin evaluator
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || isAtasanOrAdmin()
      );

      // Unggahan:
      // 1. Wajib sesuai user ID yang sedang login
      // 2. Maksimal 15 MB per berkas tunggal (kuota 1 GB / ASN)
      // 3. Hanya format foto (jpeg, png, webp) dan dokumen kedinasan resmi (PDF, Word, Excel)
      allow write: if isOwner(userId) &&
        request.resource.size <= 15 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*|application/pdf|application/vnd.openxmlformats.*|application/msword');

      // Penghapusan berkas: Pemilik atau Admin
      allow delete: if isOwner(userId) || (isAuthenticated() && request.auth.token.role == 'admin');
    }

    // 2. Path Alternatif / Fallback: /{orgId}/{userId}/{allPaths=**}
    match /{orgId}/{userId}/{allPaths=**} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || isAtasanOrAdmin()
      );

      allow write: if isOwner(userId) &&
        request.resource.size <= 15 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*|application/pdf|application/vnd.openxmlformats.*|application/msword');

      allow delete: if isOwner(userId) || (isAuthenticated() && request.auth.token.role == 'admin');
    }
  }
}
