rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Cek apakah pengguna sudah login
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Cek apakah pengguna adalah pemilik akun dokumen
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: Ambil data user dari Firestore users/{uid}
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper: Cek peran pengguna (dari custom claims atau dari dokumen user)
    function getUserRole() {
      return request.auth.token.role != null 
        ? request.auth.token.role 
        : (exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? getUserData().role : 'pegawai');
    }

    function isAdmin() {
      return isAuthenticated() && (request.auth.token.role == 'admin' || getUserRole() == 'admin');
    }

    function isAtasan() {
      return isAuthenticated() && (request.auth.token.role in ['admin', 'atasan'] || getUserRole() in ['admin', 'atasan']);
    }

    // Helper: Validasi Isolasi Multi-Tenant (White-Label)
    function isSameOrg(data) {
      // Pastikan data memiliki orgId dan sesuai dengan orgId pengguna yang login
      return isAuthenticated() && data.orgId == getUserData().orgId;
    }

    // 0. Koleksi Organizations (organizations)
    match /organizations/{orgId} {
      allow read: if isAuthenticated() && getUserData().orgId == orgId;
      allow write: if isAdmin() && getUserData().orgId == orgId;
    }

    // 1. Koleksi Pengguna (users)
    match /users/{userId} {
      // Seluruh ASN yang login dapat membaca profil rekan kerja di satu organisasi
      allow read: if isAuthenticated() && isSameOrg(resource.data);
      
      // Pembuatan profil: Admin satu organisasi
      allow create: if isSameOrg(request.resource.data) && (isAdmin() || isOwner(userId));
      
      // Pembaruan: Admin bebas, pegawai dibatasi field
      allow update: if isSameOrg(resource.data) && isSameOrg(request.resource.data) && (
        isAdmin() || (
          isOwner(userId) && 
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'nip', 'kantorId', 'storageLimitBytes', 'orgId'])
        )
      );
      
      // Hapus profil: Hanya admin BKPSDM organisasi yang sama
      allow delete: if isAdmin() && isSameOrg(resource.data);
    }

    // 2. Koleksi Presensi (presensi)
    match /presensi/{presensiId} {
      // Pemilik, atasan, atau admin satu org dapat membaca riwayat presensi
      allow read: if isSameOrg(resource.data) && (
        resource.data.userId == request.auth.uid || isAtasan()
      );
      
      allow create: if isSameOrg(request.resource.data) && (
        request.resource.data.userId == request.auth.uid || isAdmin()
      );
      
      allow update: if isSameOrg(resource.data) && isSameOrg(request.resource.data) && (
        isAdmin() || (
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid
        )
      );
      
      allow delete: if isAdmin() && isSameOrg(resource.data);
    }

    // 3. Koleksi Laporan Kegiatan Harian (lkh)
    match /lkh/{lkhId} {
      allow read: if isSameOrg(resource.data) && (
        resource.data.userId == request.auth.uid || isAtasan()
      );
      
      allow create: if isSameOrg(request.resource.data) && (
        request.resource.data.userId == request.auth.uid || isAdmin()
      );
      
      allow update: if isSameOrg(resource.data) && isSameOrg(request.resource.data) && (
        isAdmin() || 
        isAtasan() || (
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid
        )
      );
      
      allow delete: if isSameOrg(resource.data) && (
        isAdmin() || (
          resource.data.userId == request.auth.uid &&
          resource.data.status == 'draft'
        )
      );
    }

    // 4. Koleksi Pengajuan Izin & Cuti (izin)
    match /izin/{izinId} {
      allow read: if isSameOrg(resource.data) && (
        resource.data.userId == request.auth.uid || isAtasan()
      );
      
      allow create: if isSameOrg(request.resource.data) && (
        request.resource.data.userId == request.auth.uid || isAdmin()
      );
      
      allow update: if isSameOrg(resource.data) && isSameOrg(request.resource.data) && isAtasan();
      
      allow delete: if isSameOrg(resource.data) && (
        isAdmin() || (
          resource.data.userId == request.auth.uid &&
          resource.data.status == 'menunggu'
        )
      );
    }

    // 5. Koleksi Titik Kantor & Geofencing (kantor)
    match /kantor/{kantorId} {
      allow read: if isSameOrg(resource.data);
      allow write: if isSameOrg(request.resource.data) && isAdmin();
    }

    // 6. Koleksi Lembur / Overtime (lemburRecords)
    match /lemburRecords/{lemburId} {
      allow read: if isSameOrg(resource.data) && (
        resource.data.userId == request.auth.uid || isAtasan()
      );
      
      allow create: if isSameOrg(request.resource.data) && (
        request.resource.data.userId == request.auth.uid || isAdmin()
      );
      
      allow update: if isSameOrg(resource.data) && isSameOrg(request.resource.data) && (
        isAdmin() ||
        isAtasan() || (
          resource.data.userId == request.auth.uid &&
          resource.data.status in ['disetujui', 'selesai']
        )
      );
      
      allow delete: if isSameOrg(resource.data) && (
        isAdmin() || (
          resource.data.userId == request.auth.uid &&
          resource.data.status == 'draft'
        )
      );
    }
  }
}
