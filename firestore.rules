rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Cek apakah pengguna sudah login
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Cek apakah pengguna adalah pemilik akun dokumen
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: Ambil data user dari Firestore users/{uid}
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper: Cek peran pengguna (dari custom claims atau dari dokumen user)
    function getUserRole() {
      return request.auth.token.role != null 
        ? request.auth.token.role 
        : (exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? getUserData().role : 'pegawai');
    }

    function isAdmin() {
      return isAuthenticated() && (request.auth.token.role == 'admin' || getUserRole() == 'admin');
    }

    function isAtasan() {
      return isAuthenticated() && (request.auth.token.role in ['admin', 'atasan'] || getUserRole() in ['admin', 'atasan']);
    }

    // 1. Koleksi Pengguna (users)
    match /users/{userId} {
      // Seluruh ASN yang login dapat membaca profil rekan kerja (nama, NIP, kantor)
      allow read: if isAuthenticated();
      
      // Pembuatan profil: Admin, atau saat inisialisasi akun sendiri
      allow create: if isAdmin() || isOwner(userId);
      
      // Pembaruan: Admin bebas mengubah seluruh field; Pegawai dilarang mengubah role, NIP, kantorId, atau kuota storage
      allow update: if isAdmin() || (
        isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'nip', 'kantorId', 'storageLimitBytes'])
      );
      
      // Hapus profil: Hanya admin BKPSDM
      allow delete: if isAdmin();
    }

    // 2. Koleksi Presensi (presensi)
    match /presensi/{presensiId} {
      // Pemilik, atasan, atau admin dapat membaca riwayat presensi
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAtasan()
      );
      
      // Check-in baru: Wajib atas nama akun sendiri (atau admin)
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid || isAdmin()
      );
      
      // Check-out / Update: Pemilik akun sendiri atau admin
      allow update: if isAuthenticated() && (
        isAdmin() || (
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid
        )
      );
      
      // Hapus catatan presensi: Hanya admin
      allow delete: if isAdmin();
    }

    // 3. Koleksi Laporan Kegiatan Harian (lkh)
    match /lkh/{lkhId} {
      // Pemilik, atasan penilai, atau admin dapat membaca berkas LKH
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAtasan()
      );
      
      // Pembuatan laporan: Wajib atas nama user sendiri
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid || isAdmin()
      );
      
      // Update LKH:
      // - Pegawai mengedit laporan miliknya
      // - Atasan/Admin memberikan persetujuan / revisi
      allow update: if isAuthenticated() && (
        isAdmin() || 
        isAtasan() || (
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid
        )
      );
      
      // Hapus laporan: Pemilik hanya boleh menghapus saat status masih 'draft', atau admin
      allow delete: if isAuthenticated() && (
        isAdmin() || (
          resource.data.userId == request.auth.uid &&
          resource.data.status == 'draft'
        )
      );
    }

    // 4. Koleksi Pengajuan Izin & Cuti (izin)
    match /izin/{izinId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAtasan()
      );
      
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid || isAdmin()
      );
      
      // Approval izin: Hanya atasan atau admin
      allow update: if isAtasan();
      
      // Pembatalan izin: Pemilik hanya saat masih 'pending'
      allow delete: if isAuthenticated() && (
        isAdmin() || (
          resource.data.userId == request.auth.uid &&
          resource.data.status == 'pending'
        )
      );
    }

    // 5. Koleksi Titik Kantor & Geofencing (kantor)
    match /kantor/{kantorId} {
      // Seluruh ASN dapat membaca titik koordinat & radius kantor untuk keperluan radar presensi
      allow read: if isAuthenticated();
      
      // Hanya admin BKPSDM yang berhak mengubah koordinat atau radius kantor
      allow write: if isAdmin();
    }
  }
}
